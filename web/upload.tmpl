<!DOCTYPE html>  
<html>  
  
<head>  
  <meta charset="utf-8">  
  <meta http-equiv="X-UA-Compatible" content="IE=edge">  
  <meta name="viewport" content="width=device-width, initial-scale=1">  
  <title>Upload</title>  
  <link rel="stylesheet" href="/static/css/bootstrap.css">  
  <link rel="stylesheet" href="/static/css/upload.css">  
</head>  
  
<body>  
  
  <div class="container">  
  
    <div class="page-header">  
      <h1>FileUpload</h1>  
    </div>  
  
    <p>Drag files or click the "Upload Files..." button to upload new files</p>  
  
  
    <div class="btn-toolbar">  
      <div class="btn btn-primary fileinput-button">  
        Upload files  
        <input id="fileupload" type="file" name="files[]" multiple>  
      </div> 
      <div class="btn btn-primary fileinput-button">
        Upload folder
        <input id="folderupload" type="file" name="folders[]" directory multiple webkitdirectory>
      </div>
    </div>  
  
    <div class="panel panel-default">  
      <div class="panel-heading">Upload Queue</div>  
      <table class="table table-striped">  
        <tbody id="uploads">  
        </tbody>
      </table>  
    </div>  
  
    <div class="panel panel-default">  
      <div class="panel-heading">  
        <ol class="breadcrumb" id="path">  
          <li class="active">{{.}} Received Files</li>  
        </ol>  
      </div>  
      <table class="table table-striped">  
        <tbody id="listing">  
        </tbody>  
      </table>  
    </div>  
  
  </div>  
  
  <script>
    var fileInput = document.getElementById('fileupload');
    var folderInput = document.getElementById('folderupload');
    var uploads = document.getElementById('uploads');
    var listing = document.getElementById('listing');

    fileInput.addEventListener('change', function(e) {
      handleFiles(e.target.files);
    });

    folderInput.addEventListener('change', function(e) {
      handleFiles(e.target.files);
    });

    document.body.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.stopPropagation();
    }, false);

    document.body.addEventListener('drop', function(e) {
      e.preventDefault();
      e.stopPropagation();
      handleFiles(e.dataTransfer.files);
    }, false);

    // Build cells with textContent so file names are never parsed as HTML.
    function textCell(className, text) {
      var td = document.createElement('td');
      td.className = className;
      var p = document.createElement('p');
      p.textContent = text;
      td.appendChild(p);
      return td;
    }

    function handleFiles(files) {
      for (var i = 0; i < files.length; i++) {
        var file = files[i];
        var row = document.createElement('tr');
        row.appendChild(textCell('column-path', file.webkitRelativePath || file.name));

        var progressTd = document.createElement('td');
        progressTd.className = 'column-progress';
        progressTd.innerHTML = '<div class="progress"><div class="progress-bar" style="width: 0%;"></div></div>';
        row.appendChild(progressTd);

        uploads.appendChild(row);
        uploadFile(file, row);
      }
    }

    function uploadFile(file, row) {
      var progressBar = row.querySelector('.progress-bar');
      var formData = new FormData();
      formData.append("file", file, file.webkitRelativePath || file.name);
      var ajax = new XMLHttpRequest();
      ajax.upload.addEventListener('progress', function(e) {
        if (e.lengthComputable) {
          progressBar.style.width = Math.round((e.loaded / e.total) * 100) + '%';
        }
      });
      function fail(reason) {
        progressBar.style.width = '100%';
        progressBar.className += ' progress-bar-danger';
        progressBar.textContent = 'Failed: ' + reason;
      }
      ajax.addEventListener('error', function() { fail('network error'); });
      ajax.addEventListener('abort', function() { fail('cancelled'); });
      ajax.addEventListener('load', function() {
        if (ajax.status !== 200) {
          fail(ajax.responseText);
          return;
        }
        uploads.removeChild(row);
        var newRow = document.createElement('tr');
        newRow.appendChild(textCell('column-name', file.webkitRelativePath || file.name));
        newRow.appendChild(textCell('column-size', (file.size / 1024 / 1024).toFixed(2) + ' MB'));
        listing.appendChild(newRow);
      });
      ajax.open("POST", "/", true);
      ajax.send(formData);
    }
</script>  
  
</body>  
  
</html>  
